@page "/Customer"
@using webbutveckling_labb2_phuusie.Shared.DTOs.CustomerDTOs
@using webbutveckling_labb2_phuusie.Client.Components.Layout
@using webbutveckling_labb2_phuusie.Client.Services
@layout MemberLayout
@inject AccountService AccountService
@inject CustomerService CustomerService

<Tabs EnableFadeEffect="true" NavStyle="NavStyle.Underline">
    <Tab Title="Medlemmar">
        <Content>
            @if (SelectedCustomer.CustomerId is not 0)
            {
                @if (!isEditing)
                {
                    <div id="customer-info" class="container">
                        <Card class="mt-3 row">
                            <CardBody>
                                <CardTitle>@SelectedCustomer.FirstName @SelectedCustomer.LastName</CardTitle>
                                <CardText>
                                    <strong>@GetRole(SelectedCustomer.IsAdmin)</strong><br/>
                                    <strong>CustomerID:</strong> @SelectedCustomer.CustomerId
                                </CardText>
                                <CardText><strong>Email:</strong> @SelectedCustomer.Email<br /><strong>Lösenord:</strong> @SelectedCustomer.Password </CardText>
                                <CardText><strong>Telefon:</strong> @SelectedCustomer.Phone</CardText>
                                <CardText>
                                    <strong>Adress:</strong> <br />
                                    @SelectedCustomer.Address <br />
                                    @SelectedCustomer.PostalCode @SelectedCustomer.City <br />
                                    @SelectedCustomer.Country
                                </CardText> <button class="btn border btn-dark" @onclick="StartEditing">Ändra information</button>
                                <button class="btn border btn-danger" @onclick="() => RemoveCustomer(SelectedCustomer.CustomerId)"><Icon Name="IconName.Trash"></Icon></button>
                            </CardBody>
                        </Card>
                    </div>
                    <div class="line"></div>
                }
                else
                {
                    <div class="container">
                        <Card class="mt-3">
                            <CardBody>
                                <h2>CustomerID: @SelectedCustomer.CustomerId</h2>
                                <form>
                                    <div class="form-group">
                                        <label for="lastName">Email:</label>
                                        <input type="text" class="form-control" id="email" @bind="SelectedCustomer.Email">
                                    </div>
                                    <div class="form-group">
                                        <label for="lastName">Lösenord:</label>
                                        <input type="text" class="form-control" id="password" @bind="SelectedCustomer.Password">
                                    </div>
                                    <div class="form-group mt-2">
                                        <input type="checkbox" name="role" class="me-2" checked="@SelectedCustomer.IsAdmin"/>Admin
                                    </div>
                                    <div class="row mt-5">
                                        <div class="col form-group">
                                            <label for="firstName">Förnamn:</label>
                                            <input type="text" class="form-control" id="firstName" @bind="SelectedCustomer.FirstName">
                                        </div>
                                        <div class="col form-group">
                                            <label for="lastName">Efternamn:</label>
                                            <input type="text" class="form-control" id="lastName" @bind="SelectedCustomer.LastName">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="lastName">Telefon:</label>
                                        <input type="text" class="form-control" id="phone" @bind="SelectedCustomer.Phone">
                                    </div>
                                    <div class="mt-4 form-group">
                                        <label for="lastName">Gatuadress:</label>
                                        <input type="text" class="form-control" id="address" @bind="SelectedCustomer.Address">
                                    </div>
                                    <div class="row">
                                        <div class="col form-group">
                                            <label for="lastName">Postnummer:</label>
                                            <input type="text" class="form-control" id="postalCode" @bind="SelectedCustomer.PostalCode">
                                        </div>
                                        <div class="col form-group">
                                            <label for="lastName">Stad:</label>
                                            <input type="text" class="form-control" id="city" @bind="SelectedCustomer.City">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="lastName">Land:</label>
                                        <input type="text" class="form-control" id="country" @bind="SelectedCustomer.Country">
                                    </div>
                                </form>
                                <div class="mt-3 me-2">
                                    <button type="submit" class="btn border btn-success" @onclick="SaveEdit"><Icon Name="IconName.Check"></Icon></button>
                                    <button type="submit" class="btn border btn-danger" @onclick="StopEditing"><Icon Name="IconName.X"></Icon></button>
                                </div>
                            </CardBody>
                        </Card>
                    </div>
                }
            }
            <div class="container mt-3">
                <div class="d-flex row">
                    <div class="col me-auto">
                        <h2>Medlemmar</h2><br />
                    </div>
                    <div class="col">
                        <form>
                            <div class="search">
                                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z" /></svg>
                                <input class="search-input" type="search" placeholder="SÖK..." />
                            </div>
                        </form>
                    </div>
                </div>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Roll</th>
                            <th>Namn</th>
                            <th>Efternamn</th>
                            <th>Email</th>
                            <th>Telefon</th>
                            <th>Adress</th>
                            <th>Postal Code</th>
                            <th>Stad</th>
                            <th>Land</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in CustomerService.Customers)
                        {
                            <tr @onclick="() => OnRowClick(customer.CustomerId.ToString())">
                                <td>@customer.CustomerId</td>
                                <td>@GetRole(customer.IsAdmin)</td>
                                <td>@customer.FirstName</td>
                                <td>@customer.LastName</td>
                                <td>@customer.Email</td>
                                <td>@customer.Phone</td>
                                <td>@customer.Address</td>
                                <td>@customer.PostalCode</td>
                                <td>@customer.City</td>
                                <td>@customer.Country</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Content>
    </Tab>
    <Tab Title="Registering">
        <Content>
            <div class="container mt-3">
                <h2>Registera Kund</h2>
                <form>
                    <div class="form-group">
                        <label for="lastName">Email:</label>
                        <input type="text" class="form-control" id="email" @bind="NewCustomer.Email">
                    </div>
                    <div class="form-group">
                        <label for="lastName">Lösenord:</label>
                        <input type="text" class="form-control" id="password" @bind="NewCustomer.Password">
                    </div>
                    <div class="row mt-5">
                        <div class="col form-group">
                            <label for="firstName">Förnamn:</label>
                            <input type="text" class="form-control" id="firstName" @bind="NewCustomer.FirstName">
                        </div>
                        <div class="col form-group">
                            <label for="lastName">Efternamn:</label>
                            <input type="text" class="form-control" id="lastName" @bind="NewCustomer.LastName">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Telefon:</label>
                        <input type="text" class="form-control" id="phone" @bind="NewCustomer.Phone">
                    </div>
                    <div class="mt-4 form-group">
                        <label for="lastName">Gatuadress:</label>
                        <input type="text" class="form-control" id="address" @bind="NewCustomer.Address">
                    </div>
                    <div class="row">
                        <div class="col form-group">
                            <label for="lastName">Postnummer:</label>
                            <input type="text" class="form-control" id="postalCode" @bind="NewCustomer.PostalCode">
                        </div>
                        <div class="col form-group">
                            <label for="lastName">Stad:</label>
                            <input type="text" class="form-control" id="city" @bind="NewCustomer.City">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Land:</label>
                        <input type="text" class="form-control" id="country" @bind="NewCustomer.Country">
                    </div>
                    <button type="submit" class="btn btn-dark mt-5" @onclick="() => RegisterCustomer(NewCustomer)">Register</button>
                </form>
            </div>
        </Content>
    </Tab>
</Tabs>


@code {

    GetCustomerDto? SelectedCustomer { get; set; } = new();

    PostCustomerDto NewCustomer { get; set; } = new();

    PutCustomerDto UpdatedCustomer { get; set; } = new();

    bool isEditing;

    protected override async Task OnInitializedAsync()
    {
        await CustomerService.LoadCustomers();
    }

    async Task RegisterCustomer(PostCustomerDto customer)
    {
        await CustomerService.RegisterCustomer(customer);
    }

    async Task UpdateCustomer()
    {
        UpdatedCustomer = new()
        {
            CustomerId = SelectedCustomer.CustomerId,
            Email = SelectedCustomer.Email,
            Password = SelectedCustomer.Password,
            FirstName = SelectedCustomer.FirstName,
            LastName = SelectedCustomer.LastName,
            Phone = SelectedCustomer.Phone,
            Address = SelectedCustomer.Address,
            PostalCode = SelectedCustomer.PostalCode,
            City = SelectedCustomer.City,
            Country = SelectedCustomer.Country,
            IsAdmin = SelectedCustomer.IsAdmin
        };

        await CustomerService.UpdateCustomer(UpdatedCustomer);
    }

    async Task RemoveCustomer(int customerId)
    {
        await CustomerService.DeleteCustomer(customerId);
        SelectedCustomer = new();

    }

    string GetRole(bool isAdmin)
    {
        return isAdmin ? "Admin" : "Kund";
    }

    void OnRowClick(string customerId)
    {
        SelectedCustomer = CustomerService.Customers.FirstOrDefault(c => c?.CustomerId.ToString() == customerId);
    }

    void StartEditing()
    {
        isEditing = true;
    }

    void StopEditing()
    {
        isEditing = false;
    }

    async Task SaveEdit()
    {
        isEditing = false;

        await UpdateCustomer();
    }
}
